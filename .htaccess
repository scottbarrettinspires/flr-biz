Options -Indexes
DirectoryIndex index.php
RewriteEngine On
# Never serve app code, saved data or build sources
RewriteRule ^(_app|_data|_source)(/|$) - [R=404,L]
# Real files (assets, uploads) are served directly; everything else goes to the app
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]
